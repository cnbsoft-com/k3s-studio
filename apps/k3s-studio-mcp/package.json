{
  "name": "@cnbsoft/k3s-studio-mcp",
  "version": "0.1.0",
  "description": "MCP server for k3s-studio — control k3s clusters via AI prompts",
  "main": "dist/index.js",
  "bin": {
    "k3s-studio-mcp": "dist/index.js"
  },
