# docker compose up 전에 이 파일을 .env로 복사하고 값을 채우세요.
# cp .env.example .env

# Postgres 비밀번호
DB_PASSWORD=changeme

# AES-256 암호화 키 (서버 SSH 개인키 저장에 사용). 생성: openssl rand -hex 32
ENCRYPTION_KEY=

# UI가 실행되는 오리진 (콤마로 여러 개 지정 가능)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 인증 (Keycloak, cnb-investment와 같은 cnb realm 공유)
KEYCLOAK_ISSUER_URI=https://keycloak.cnbsoft.com/realms/cnb
KEYCLOAK_ISSUER=https://keycloak.cnbsoft.com/realms/cnb
KEYCLOAK_CLIENT_ID=k3s-studio-web
APP_BASE_URL=http://localhost:3000
