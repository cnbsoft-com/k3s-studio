<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V7_1__add_server_network_columns_to_clusters" author="mpk3s">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="clusters" columnName="server_id"/>
            </not>
        </preConditions>
        <addColumn tableName="clusters">
            <column name="server_id" type="BIGINT"/>
            <column name="network_interface" type="VARCHAR(255)"/>
            <column name="network_interface_cidr" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="V7_2__add_server_id_to_jobs" author="mpk3s">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="jobs" columnName="server_id"/>
            </not>
        </preConditions>
        <addColumn tableName="jobs">
            <column name="server_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
